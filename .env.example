# Buyer Hub — environment template
#
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored, so your real secrets never leave your machine.
#
#   cp .env.example .env.local
#

# ---------------------------------------------------------------------------
# DATABASE_URL  (required)
# ---------------------------------------------------------------------------
# Your Supabase Postgres connection string.
#
# Where to find it:
#   1. Open your project at https://supabase.com/dashboard
#   2. Click the green "Connect" button at the top of the page
#   3. Copy the URI under "Connection string"
#   4. Replace [YOUR-PASSWORD] with the database password you chose
#      when you created the project
#
# It should look like this (this is an example, not a real database):
# DATABASE_URL="postgresql://postgres.abcdefghijkl:your-password-here@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"
DATABASE_URL=""

# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY  (optional — not needed until Session 6)
# ---------------------------------------------------------------------------
# Powers the "Fill in from brief" button on the add/edit buyer screen.
# That button is hidden entirely while this is empty, so the app runs fine
# without it. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------------------
# ANTHROPIC_MODEL  (optional)
# ---------------------------------------------------------------------------
# Which model the "Fill in from brief" button uses.
# Leave this alone unless you have a reason to change it.
ANTHROPIC_MODEL="claude-sonnet-5"
